<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TokenBurnRate.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <!-- ColorPicker (Views/ColorPickerWindow.axaml) ships its theme as a resource
             dictionary in its own assembly, not bundled into FluentTheme - without this the
             control renders with no palette or hex entry at all. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    </Application.Styles>
</Application>