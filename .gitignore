## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build output
[Bb]in/
[Oo]bj/
publish/
.vs/

# IDE and per-developer settings. These hold local paths, window layouts and launch
# profiles - one developer's copy is noise in everyone else's checkout.
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
.idea/
.vscode/

# The app's own state file. Builds from 1.0.0-beta.11 on keep it under
# %LOCALAPPDATA%/~/.local/share (see AppState's class comment), but every earlier build
# wrote it beside the executable - so a working tree that ever ran one still has this file
# in the repo root, and AppState's migration moves it out only once the new build is run.
# Keep the rule: it holds this machine's window position and its spending history, never
# something to publish. The Claude and GitHub token files have always lived in the per-user
# folder, so they need no rule here.
/Token-Burn-Rate.json

# Crash reports. Now written alongside the state file under %LOCALAPPDATA%/~/.local/share
# (see CrashLog, which derives the folder from AppState.Path), but pre-beta.11 builds
# dropped them beside the executable, so a source build's output folder can still hold
# some.
*.crash.*.log

# OS and tooling debris
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
