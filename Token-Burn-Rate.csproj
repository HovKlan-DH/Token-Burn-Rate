<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>

	<AssemblyName>Token-Burn-Rate</AssemblyName>
	<RootNamespace>TokenBurnRate</RootNamespace>
	<Title>Token Burn Rate</Title>
	<Product>Token Burn Rate</Product>
	<Description>Live Claude Code and GitHub Copilot usage.</Description>
	<Copyright>©2026 Dennis Helligsø</Copyright>

	<AssemblyVersion>1.0.0</AssemblyVersion>
	<InformationalVersion>1.0.0-beta.3</InformationalVersion>

	<!-- Must stay below the two properties they read: MSBuild evaluates a PropertyGroup
	     top-to-bottom, so placing these first silently resolved FileVersion to empty and
	     Version to a bare 1.0.0 (the SDK's fallback), dropping the pre-release suffix. -->
	<FileVersion>$(AssemblyVersion)</FileVersion>
	<Version>$(InformationalVersion)</Version>
	  
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<!-- Otherwise the SDK appends "+<git-sha>" to InformationalVersion (and so to
	    Explorer's Properties > Details > Product version), which VersionText in
	    MainViewModel already strips back off for the in-app display - keep the raw
	    assembly attribute clean too instead of relying on that trim everywhere. -->

  </PropertyGroup>

  <!-- Self-contained publish, packaged by Velopack into one installer per OS (see
       build-and-release.yml). Not PublishSingleFile: vpk pack needs the unpacked publish
       folder as its input and produces the single downloadable file itself (Setup.exe /
       .pkg / .AppImage) - see .claude/memory for the tradeoff this replaced.
       Trimming is intentionally OFF: Avalonia XAML resolves types by reflection and
       trimming breaks it only in published builds, which is exactly where it is hardest
       to diagnose. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so Window.Icon can load it at runtime; ApplicationIcon above only
         stamps the .exe, which is a separate mechanism. -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <!-- Avalonia 12's own transitive floor (0.95.1) already carries the fix for
         GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959), so the explicit override this project used to
         need under Avalonia 11 is gone - forcing an older version here would fight that
         floor instead of matching it. -->
    <!-- No 12.x build exists yet; latest available is still on the 11.3 line. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- DPAPI, for encrypting the Claude OAuth refresh token at rest - see ClaudeTokenStore.
         Referenced for every RID on purpose, even though Protect/Unprotect only ever run on
         Windows (they early-return behind OperatingSystem.IsWindows()).

         Making it win-only was tried and reverted: the reference is what puts ProtectedData
         and DataProtectionScope on the compiler's radar at all, so dropping it for linux-x64
         or osx-* fails the build outright with CS1069 rather than quietly excluding dead
         code. Gating it would mean wrapping the call sites in #if as well, which buys back
         one small assembly per non-Windows installer in exchange for conditional compilation
         in the most security-sensitive file in the project. Not worth it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
