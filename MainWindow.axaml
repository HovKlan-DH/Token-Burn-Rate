<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TokenBurnRate.ViewModels"
        xmlns:conv="clr-namespace:TokenBurnRate.Views"
        mc:Ignorable="d"
        x:Class="TokenBurnRate.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Token Burn Rate"
        Icon="avares://Token-Burn-Rate/Assets/icon.ico"
        Width="340" SizeToContent="Height"
        MinWidth="300" MaxWidth="340"
        Topmost="{Binding Pinned}"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="AcrylicBlur"
        Background="#F21A1B1E">

  <Window.Resources>
    <conv:DimOpacityConverter x:Key="DimOpacity"/>
    <conv:ChevronConverter x:Key="Chevron"/>
    <conv:HeaderTipConverter x:Key="HeaderTip"/>
    <conv:ColourBrushConverter x:Key="Brush"/>

    <!-- One template for all three panels. They differed only in the accent colour and in
         whether the caption reddens with the bar, so both now travel on the bar itself
         (Accent, WarnCaption) rather than being three near-identical copies to keep in
         step. Fixed label and value columns keep every bar starting and ending at the same
         x, and bottom alignment lines the text up with the bar band rather than with the
         caption above it. -->
    <DataTemplate x:Key="BarTemplate" x:DataType="vm:BarViewModel">
      <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*,64"
            Opacity="{Binding IsEnabled, Converter={StaticResource DimOpacity}}">
        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="barlabel"
                   VerticalAlignment="Bottom" Margin="0,0,8,-3"
                   Width="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LabelWidth}"/>
        <conv:UsageBar Grid.Column="1" Height="18" VerticalAlignment="Bottom"
                       Fraction="{Binding Fraction}"
                       Caption="{Binding DetailText}"
                       Track="#3A3D44"
                       CaptionBrush="{Binding CaptionColour, Converter={StaticResource Brush}}"
                       CaptionHighlightBrush="{Binding CaptionHighlightColour, Converter={StaticResource Brush}}"
                       Fill="{Binding FillColour, Converter={StaticResource Brush}}"
                       Markers="{Binding Markers}"
                       TodayMarkerIndex="{Binding TodayMarkerIndex}"
                       MarkerAccentBrush="#F85149"/>
        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Classes="barvalue"
                   VerticalAlignment="Bottom" Margin="8,0,0,-4"
                   HorizontalAlignment="Right"
                   Foreground="{Binding ValueColour, Converter={StaticResource Brush}}"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button#RefreshButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26282D"/>
    </Style>
    <Style Selector="TextBlock.countdown">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#6B7079"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.chevron">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#8A8F98"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.barlabel">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="#8A8F98"/>
    </Style>
    <Style Selector="TextBlock.barvalue">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="#6B7079"/>
    </Style>
  </Window.Styles>

  <!-- Right-click anywhere to show or hide whole panels. The last visible panel cannot be
       hidden, since this menu is the only way to bring one back. -->
  <!-- Background makes the whole surface hit-testable: without it, right-click and drag
       only work where there happens to be content. SizeAll marks the widget as draggable. -->
  <Border Padding="14,12" CornerRadius="8" Background="#01000000" Cursor="SizeAll">
    <Border.ContextMenu>
      <ContextMenu>
        <!-- A non-interactive caption; the items below it are the actual toggles. -->
        <MenuItem Header="Show these panels:" IsEnabled="False"/>
        <!-- A panel with no data at all is dropped from the menu rather than greyed out:
             on a machine without Claude, an entry that can never do anything is noise. -->
        <!-- Deliberately not bound to IsEnabled: the last panel standing still reads as a
             normal, black menu entry, because it is not broken - it is simply the one that
             cannot be turned off. Greying it made a checked panel look unavailable. The
             refusal lives in SetHidden, which also puts the tick back. -->
        <MenuItem Header="Claude" ToggleType="CheckBox"
                  IsVisible="{Binding ClaudeAvailable}"
                  IsChecked="{Binding !ClaudeHidden, Mode=TwoWay}"/>
        <MenuItem Header="GitHub Copilot" ToggleType="CheckBox"
                  IsVisible="{Binding CopilotAvailable}"
                  IsChecked="{Binding !CopilotHidden, Mode=TwoWay}"/>
        <MenuItem Header="GitHub Copilot : My Pace" ToggleType="CheckBox"
                  IsVisible="{Binding PacingAvailable}"
                  IsChecked="{Binding !PacingHidden, Mode=TwoWay}"/>
        <Separator/>
        <MenuItem Header="Panel colors">
          <MenuItem Name="ClaudeColorItem" Header="Claude…"/>
          <MenuItem Name="CopilotColorItem" Header="GitHub Copilot…"/>
          <MenuItem Name="PacingColorItem" Header="GitHub Copilot : My Pace…"/>
        </MenuItem>
        <MenuItem Header="Text size">
          <MenuItem Name="BiggerTextItem" Header="Make bigger"
                    IsEnabled="{Binding CanIncreaseFontScale}"/>
          <MenuItem Name="SmallerTextItem" Header="Make smaller"
                    IsEnabled="{Binding CanDecreaseFontScale}"/>
          <MenuItem Name="ResetTextItem" Header="Reset to default"/>
        </MenuItem>
        <MenuItem Header="Workdays in a week"
                  ToolTip.Tip="How many days count as a workday for GitHub Copilot : My Pace - the first N days starting Monday">
          <MenuItem Header="1" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays1, Mode=TwoWay}"/>
          <MenuItem Header="2" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays2, Mode=TwoWay}"/>
          <MenuItem Header="3" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays3, Mode=TwoWay}"/>
          <MenuItem Header="4" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays4, Mode=TwoWay}"/>
          <MenuItem Header="5" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays5, Mode=TwoWay}"/>
          <MenuItem Header="6" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays6, Mode=TwoWay}"/>
          <MenuItem Header="7" ToggleType="Radio" GroupName="WorkDaysPerWeek"
                    IsChecked="{Binding IsWorkDays7, Mode=TwoWay}"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Start with the computer" ToggleType="CheckBox"
                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                  IsEnabled="{Binding AutostartSupported}"
                  ToolTip.Tip="Launch automatically when you log in"/>
        <!-- Hidden outright where no tray exists, rather than offering a choice that would
             leave the close button unable to do anything. -->
        <MenuItem Header="Close button minimises to tray" ToggleType="CheckBox"
                  IsVisible="{Binding TraySupported}"
                  IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                  ToolTip.Tip="Keep running in the notification area instead of exiting"/>
        <Separator/>
        <MenuItem Name="OpenFolderItem" Header="Open application folder"
                  ToolTip.Tip="Open the folder holding the executable and the state file"/>
        <MenuItem Header="About">
          <MenuItem Name="ProjectPageItem" Header="Project page on GitHub"
                    ToolTip.Tip="https://github.com/HovKlan-DH/Token-Burn-Rate"/>
          <Separator/>
          <!-- Non-interactive: just tells the user which build they are running, now that
               updates apply themselves silently in the background (see UpdateService). -->
          <MenuItem Header="{Binding VersionText}" IsEnabled="False"/>
        </MenuItem>
        <Separator/>
        <MenuItem Name="ExitItem" Header="Exit application"
                  ToolTip.Tip="Quit Token Burn Rate completely"/>
      </ContextMenu>
    </Border.ContextMenu>
    <LayoutTransformControl Name="ScaleRoot">
      <LayoutTransformControl.LayoutTransform>
        <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}"/>
      </LayoutTransformControl.LayoutTransform>
    <StackPanel Spacing="8">

      <!-- Header: doubles as the drag handle for a frameless widget -->
      <!-- Background is required for the empty parts of the row to be hit-testable;
           without it there is nothing to grab now that the title text is gone. -->
      <Grid ColumnDefinitions="*,Auto" Name="DragHandle" Background="Transparent"
            Cursor="SizeAll">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <!-- Left edge matches the section chevrons below. The dot is narrower than a
               chevron glyph, so it carries extra right margin to put the text that follows
               on the same x as the headers. -->
          <Ellipse Width="7" Height="7" Fill="#3FB950" VerticalAlignment="Center"
                   Margin="0,1,3,0"/>
          <!-- The countdown stands in for the app name. Both services refresh on one timer,
               so there is a single figure; the time and the icon form one button, so either
               can be clicked to refresh. -->
          <Button Name="RefreshButton" Padding="0,2,5,2" Background="Transparent"
                  BorderThickness="0" CornerRadius="4" Cursor="Hand"
                  ToolTip.Tip="Time until the next automatic refresh - click to refresh now">
            <!-- Centred on a shared baseline: the glyph's optical centre sits lower than
                 the digits', so it is nudged up to line the two up. -->
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="{Binding Countdown}" Classes="countdown"
                         VerticalAlignment="Center"/>
              <TextBlock Text="⟳" FontSize="12" Foreground="#8A8F98"
                         VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Name="PinButton" Padding="5,1" FontSize="11"
                  Background="Transparent" Foreground="#8A8F98" BorderThickness="0"
                  Cursor="Hand" ToolTip.Tip="{Binding PinTooltip}">
            <!-- The pin glyph renders taller than the close cross, so its centre sits
                 lower; the negative bottom margin lifts it onto the same line. -->
            <TextBlock Text="{Binding PinGlyph}" Opacity="{Binding PinOpacity}"
                       VerticalAlignment="Center" Margin="0,0,0,3"/>
          </Button>
          <Button Name="CloseButton" Content="✕" Padding="6,1" FontSize="10"
                  Background="Transparent" Foreground="#8A8F98" BorderThickness="0"
                  Cursor="Hand" ToolTip.Tip="Close"/>
        </StackPanel>
      </Grid>

      <!-- Stands in for the panels until the first poll reports something. Every panel is
           invisible until its own service has data, so without this the window is a header
           row over nothing - which on a cold boot, where the network is usually not up yet,
           reads as a broken widget rather than one still starting. Plain text, no border or
           fill: it is not a panel, just what the header row says while none exist yet. -->
      <StackPanel IsVisible="{Binding IsLoading}" Orientation="Horizontal" Spacing="8"
                  Margin="0,2,0,2">
        <TextBlock Text="⟳" FontSize="12" Foreground="#8A8F98"
                   VerticalAlignment="Center" Margin="0,-1,0,0"/>
        <TextBlock Text="{Binding LoadingText}" Classes="subtitle"
                   VerticalAlignment="Center"
                   TextTrimming="None" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Claude: hidden entirely when the service is not present on this machine -->
      <StackPanel Spacing="6" IsVisible="{Binding ClaudeVisible}">
        <!-- The last panel standing cannot be collapsed, so it drops the chevron and the
             click affordance rather than offering a toggle that does nothing. -->
        <Grid ColumnDefinitions="Auto,Auto,*" Name="ClaudeHeader" Background="Transparent"
              ToolTip.Tip="{Binding ClaudeSolo, Converter={StaticResource HeaderTip}}">
          <TextBlock Grid.Column="0" Classes="chevron"
                     Foreground="{Binding ClaudeAccentColor, Converter={StaticResource Brush}}"
                     IsVisible="{Binding !ClaudeSolo}"
                     Text="{Binding ClaudeExpanded, Converter={StaticResource Chevron}}"/>
          <TextBlock Grid.Column="1" Text="CLAUDE" Classes="section"
                     Foreground="{Binding ClaudeAccentColor, Converter={StaticResource Brush}}"/>
          <TextBlock Grid.Column="2" Text="{Binding ClaudeSubtitle}" Classes="subtitle"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                     MaxWidth="200"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding ClaudeBars}" IsVisible="{Binding ClaudeExpanded}"
                      ItemTemplate="{StaticResource BarTemplate}"/>
      </StackPanel>

      <!-- Copilot -->
      <StackPanel Spacing="6" IsVisible="{Binding CopilotVisible}">
        <Grid ColumnDefinitions="Auto,Auto,*" Name="CopilotHeader" Background="Transparent"
              ToolTip.Tip="{Binding CopilotSolo, Converter={StaticResource HeaderTip}}">
          <TextBlock Grid.Column="0" Classes="chevron"
                     Foreground="{Binding CopilotAccentColor, Converter={StaticResource Brush}}"
                     IsVisible="{Binding !CopilotSolo}"
                     Text="{Binding CopilotExpanded, Converter={StaticResource Chevron}}"/>
          <TextBlock Grid.Column="1" Text="GITHUB COPILOT" Classes="section"
                     Foreground="{Binding CopilotAccentColor, Converter={StaticResource Brush}}"/>
          <TextBlock Grid.Column="2" Text="{Binding CopilotSubtitle}" Classes="subtitle"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                     MaxWidth="200"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding CopilotBars}" IsVisible="{Binding CopilotExpanded}"
                      ItemTemplate="{StaticResource BarTemplate}"/>

        <!-- Shown only when a sign-in would fix the panel; uses the GitHub device flow,
             so no CLI install and no admin rights are required. -->
        <Button Name="SignInButton"
                IsVisible="{Binding CopilotNeedsSignIn}"
                Content="{Binding SignInText}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,5" FontSize="10"
                Background="#1F6FEB" Foreground="White"
                BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
      </StackPanel>

      <!-- The user's own pacing view, derived from the credit balance above. -->
      <StackPanel Spacing="6" IsVisible="{Binding PacingVisible}">
        <!-- The full name plus its subtitle cannot share one line at a readable size, so
             the subtitle sits underneath rather than being truncated. -->
        <StackPanel Spacing="2" Name="PacingHeader" Background="Transparent"
                    ToolTip.Tip="{Binding PacingSolo, Converter={StaticResource HeaderTip}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="chevron"
                       Foreground="{Binding PacingAccentColor, Converter={StaticResource Brush}}"
                       IsVisible="{Binding !PacingSolo}"
                       Text="{Binding PacingExpanded, Converter={StaticResource Chevron}}"/>
            <TextBlock Text="GITHUB COPILOT : MY PACE" Classes="section"
                       Foreground="{Binding PacingAccentColor, Converter={StaticResource Brush}}"/>
          </StackPanel>
          <TextBlock Text="{Binding PacingSubtitle}" Classes="subtitle"
                     IsVisible="{Binding PacingExpanded}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding PacingBars}" IsVisible="{Binding PacingExpanded}"
                      ItemTemplate="{StaticResource BarTemplate}"/>
      </StackPanel>


    </StackPanel>
    </LayoutTransformControl>
  </Border>
</Window>
